# ========================================================
# Online Assessment Live Monitor — Environment Variables
# ========================================================

# Node Environment ('production' on Railway, 'development' locally)
NODE_ENV="production"

# Port (injected automatically by Railway, default: 3000)
PORT=3000

# App URL (your Railway generated domain or custom domain)
APP_URL="https://your-app.up.railway.app"

# ── MongoDB Connection String (Required) ──────────────────
# Use MongoDB Atlas or Railway's built-in MongoDB plugin
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/examdb?retryWrites=true&w=majority"

# ── JWT Secret Key (Required) ─────────────────────────────
# 32+ character random string to sign auth and invite tokens
JWT_SECRET="your_custom_jwt_secret_key_here"

# ── Gemini AI API Key (Optional / Recommended) ────────────
# Used by recruiters to generate challenges (Free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"

# ── Judge0 Code Execution API URL (Optional / Recommended) 
# Point to your Railway Judge0 CE service (e.g. http://judge0.railway.internal:2358)
# If omitted or offline, the server falls back to native container execution
JUDGE0_API_URL="http://127.0.0.1:2358"
