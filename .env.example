# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/examdb?retryWrites=true&w=majority"

# App URL
APP_URL="http://localhost:3000"

# Gemini API key for AI question generation (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"

# Judge0 API URL (self-hosted in Docker)
JUDGE0_API_URL="http://127.0.0.1:2358"
