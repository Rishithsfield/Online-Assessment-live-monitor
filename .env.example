# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/examdb?retryWrites=true&w=majority"

# App URL
APP_URL="http://localhost:3000"

# Gemini API key for AI question generation (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"

# No code execution API needed:
# - JavaScript runs in Node.js vm sandbox (server-side, built-in)
# - Python runs in Pyodide WebAssembly (browser-side, CDN-loaded)
